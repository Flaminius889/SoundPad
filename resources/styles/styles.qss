/*QHeaderView*/

QHeaderView::section
{
    background-color: #f0f0f0;
    border: none;
    padding: 6px;
    font-weight: bold;
}

QHeaderView::section:hover
{
    background-color: #dcdcdc;
}

QHeaderView::section:pressed
{
    padding-left: 2px;
    padding-top: 2px;
    background: #dcdcdc;
}

/*QTableView*/

QTableView#soundsTable QHeaderView::section {
    border: none;
    border-right: 1px solid #454545;
}

QTableView::item:selected:hover {
    border: none;
    background-color: transparent;
    outline: none;
}

QTableView::item:selected {
    background-color: transparent;
}

QTableView::item:selected:active {
    background-color: #c7e3ff;
}

QTableView::item:selected:!active {
    background-color: #c7e3ff;
}

QTableView {
    selection-background-color: transparent;
    selection-color: black;
    outline: none;
}

QTableView::item:focus {
    outline: none;
}

/*QTreeView*/

QTreeView
{
    background: white;
    color: black;

    border: none;

    outline: none;

    font-size: 13px;

    padding: 4px;
    show-decoration-selected: 1;
}

QTreeView::item
{
    height: 28px;

    padding-left: 8px;
    padding-right: 8px;
}

QTreeView::item:hover
{
    background: transparent;
}

QTreeView::item:selected
{
    background: #0A64D8;
    color: white;
}

QTreeView::item:selected:active
{
    background: #0A64D8;
}

QTreeView::item:selected:!active
{
    background: #404040;
}

QTreeView::branch
{
    background: transparent;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical
{
    height:0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical
{
    background:none;
}

/* Sliders */

QSlider::groove:horizontal {
    height: 6px;
    background: lightgray;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #2196F3;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #FFFFFF;
    border: 1px solid #B0BEC5;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

/* Simple buttons */

QPushButton {
    background: #f0f0f0;
    border: none;
}

QPushButton:hover {
    background: #e5e5e5;
}

QPushButton:pressed {
    padding-left: 2px;
    padding-top: 2px;
    background: #dcdcdc;
}

QPushButton#repeat_btn:checked {
    background: #b8d8ff;
}
